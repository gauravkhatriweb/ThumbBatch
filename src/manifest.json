{
  "manifest_version": 3,
  "name": "ThumbBatch",
  "version": "1.0.0",
  "description": "Bulk YouTube thumbnails. One click.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ThumbBatch"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "*://i.ytimg.com/*",
    "*://img.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
